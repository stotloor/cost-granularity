# Secret used to sign auth tokens. Set a long random value in production.
APEX_SECRET=change-me
# PostgreSQL holding the dashboard data (database/schema.sql + load_workbook.py).
DATABASE_URL=postgresql://localhost/cost_granularity
# APEX_PG_SCHEMA=cost_granularity
# APEX_FISCAL_YEAR=2026
# Comma-separated allowed origins for CORS (default '*').
APEX_CORS=*

# --- Transactional emails (Wave 1 #2). Choose SMTP or Resend. ---
FROM_EMAIL=noreply@example.com
# SMTP (e.g., Gmail, SendGrid):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# Or Resend API:
# RESEND_API_KEY=re_...

# --- AI features (capability 17). Leave unset to run the AI in simulated mode. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Payments (capability 20). Leave unset to simulate checkout. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Maps (locations & routes). Restrict this key by HTTP referrer
# in Google Cloud Console -- it is served to the browser via GET
# /api/integrations/public/maps-key, same as any Maps JS API key. ---
GOOGLE_MAPS_API_KEY=

# --- External integrations (capabilities 15, 16). ---
SAP_S4_API_KEY=
COUPA_API_KEY=
FASTDRAFT_API_KEY=
P6_API_KEY=
